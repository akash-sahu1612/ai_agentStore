<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-4 ">
        <br/> 
    <h3>Create a New Listing</h3>
    <form 
    method="POST" action="/listings" 
    novalidate class="needs-validation" 
    enctype="multipart/form-data"
    >
    <div class="mb-3">
        <lable for="title" class="form-label">Title</label>
        <input name="listing[title]" 
        placeholder="enter title" 
        type="text"  
        class="form-control"
        required
        />
        <div class="valid-feedback">Title looks fine</div>
    </div>
    <div class="mb-3">
        <lable for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control" required></textarea>
    <div class="invalid-feedback">Please enter Short Description</div> 
        

    </div>
    
        <div class="mb-3">
        <lable for="image" 
        class="form-label" 
        class-"form-label">Upload Image</label>
        <input name="listing[image]" 
        type="file" 
        class="form-control" 
        />
        required
    </div>
    <div class="row">
    <div class="mb-3 col-md-4">
        <lable for="price" class="form-label">Price</label>
        <input name="listing[price]" placeholder="Rs 101" type="number" class="form-control" required>
        <div class="invalid-feedback">Please enter valid Price</div>

    </div>    
    <div class="mb-3 col-md-8">
        <lable for="country" class="form-label">Country</label>
        <input name="listing[country]" placeholder="enter country" type="text" class="form-control" required>
        <div class="invalid-feedback">Please enter valid Country Name</div>
    </div>
    </div>
    <div class="mb-3">
        <lable for="location" class="form-label">Location</label>
        <input name="listing[location]" placeholder="enter location" type="text" class="form-control" required>
        <div class="invalid-feedback">Please enter valid Location</div>
    </div>
    
        <button class="add-btn mt-3">Add</button>
    <br><br>
    </form>
    </div>
</div>
